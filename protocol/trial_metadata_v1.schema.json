{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flightmill.local/schema/trial_metadata_v1.schema.json",
  "title": "Flight Mill V1 trial metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata_schema_version", "trial_uuid", "session_id",
    "created_at_local_iso8601", "incomplete", "species_code", "trial_type",
    "trial_number", "well_id", "attempt", "arm_radius_m", "circumference_m",
    "min_event_interval_us", "device_id", "exact_esp32s3_dev_board_model",
    "firmware_version", "protocol_version",
    "application_version", "serial_port", "baud_rate", "accepted_event_count",
    "final_dropped_events"
  ],
  "properties": {
    "metadata_schema_version": {"const": 1},
    "trial_uuid": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "created_at_local_iso8601": {"type": "string", "format": "date-time"},
    "started_at_local_iso8601": {"type": ["string", "null"], "format": "date-time"},
    "stopped_at_local_iso8601": {"type": ["string", "null"], "format": "date-time"},
    "actual_duration_s": {"type": ["number", "null"], "minimum": 0},
    "planned_duration_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "stop_reason": {"type": ["string", "null"]},
    "incomplete": {"type": "boolean"},
    "species_code": {"type": "string", "minLength": 1},
    "species_name": {"type": ["string", "null"]},
    "trial_type": {"type": "string", "minLength": 1},
    "trial_number": {"type": "integer", "minimum": 1},
    "well_id": {"type": "string", "minLength": 1},
    "individual_id": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 1},
    "operator": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "arm_radius_m": {"type": "number", "exclusiveMinimum": 0, "default": 0.1},
    "circumference_m": {"type": "number", "exclusiveMinimum": 0},
    "min_event_interval_us": {"type": "integer", "enum": [50000, 150000], "default": 150000},
    "device_id": {"type": "string", "minLength": 1},
    "exact_esp32s3_dev_board_model": {"type": "string", "minLength": 1},
    "hardware_revision": {"type": ["string", "null"]},
    "firmware_version": {"type": "string", "minLength": 1},
    "protocol_version": {"const": 1},
    "application_version": {"type": "string", "minLength": 1},
    "serial_port": {"type": "string", "minLength": 1},
    "baud_rate": {"type": "integer", "minimum": 1},
    "accepted_event_count": {"type": "integer", "minimum": 0},
    "final_dropped_events": {"type": "integer", "minimum": 0},
    "raw_csv_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
